# Set spatial dimensions and CRS for output
for freq_da in [polynya_frequency_2003_2010, polynya_frequency_2011_2025]:
    freq_da.rio.set_spatial_dims(x_dim="x", y_dim="y", inplace=True)
    freq_da.rio.write_crs("EPSG:4326", inplace=True)

# Save the aggregated .tif files
