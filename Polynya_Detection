polynya_frequency_2011_2025.rio.to_raster(
    os.path.join(output_dir, "polynya_frequency_2011-2025.tif"),
    dtype='float32',
    nodata=np.nan
)

print("Aggregated .tif files for 2003-2010 and 2011-2025 saved.")

# --- Generate Polynya Contours for 2003-2010 ---
all_contours = []
contour_lines = []

# Define transform for coordinate conversion
transform = rasterio.transform.from_bounds(
    target_lon.min(), target_lat.min(),
    target_lon.max(), target_lat.max(),
    len(target_lon), len(target_lat)
)

# Process only 2003-2010 data for contour generation
for ds in datasets:
    year = int(str(ds.time.values[0])[:4])
    if not (2003 <= year <= 2010):
        continue

    # Reuse data preparation logic
    data = ds["ice_conc"].values
    x, y = ds.x.values, ds.y.values

    # Handle shape mismatches
    if data.shape == (len(x), len(y)): data = data.T
    if data.shape[0] > len(y): data = data[:len(y), :]
    if data.shape[1] > len(x): data = data[:, :len(x)]

    x_grid, y_grid = np.meshgrid(x, y)
    if 2020 <= year <= 2026:
        points = np.column_stack((x_grid.ravel(), y_grid.ravel()))
        values = data.ravel()
        valid_mask = ~np.isnan(values) & ~np.isnan(points[:, 0]) & ~np.isnan(points[:, 1])
        regridded_data = griddata(
            points[valid_mask], values[valid_mask],
            (target_lon_grid.ravel(), target_lat_grid.ravel()), method='nearest'
        ).reshape(target_lon_grid.shape)
        ds_regridded = xr.Dataset({"ice_conc": (["y", "x"], regridded_data)},
                                  coords={"y": target_lat, "x": target_lon})
    else:
        ds_regridded = ds
    ds_regridded = ds_regridded.assign_coords(time=[ds.time.values[0]])

    # Get polynya mask and find contour lines where value == 1
    polynya_mask = detect_polynyas(ds_regridded, land_mask, threshold=85, variable="ice_conc").values
    contours = find_contours(polynya_mask, level=0.5)  # 0.5 for binary mask (1 vs 0)

    # Convert contours to LineStrings
    for contour in contours:
        xs, ys = rasterio.transform.xy(transform, contour[:, 0], contour[:, 1])
        line = LineString(zip(xs, ys))
        contour_lines.append({
            'geometry': line,
            'time': ds_regridded.time.values[0],
            'year': year
        })

# Save as a single .shp file
if contour_lines:
    output_dir = "C:/Users/mmarage"
    os.makedirs(output_dir, exist_ok=True)
    gdf = gpd.GeoDataFrame(contour_lines, crs="EPSG:4326")
    output_shp = os.path.join(output_dir, "polynya_contour_lines_2003-2010.shp")
    gdf.to_file(output_shp)
    print(f"✅ Saved {len(gdf)} contour lines to {output_shp}")
else:
    print("❌ No contours found for 2003-2010.")
