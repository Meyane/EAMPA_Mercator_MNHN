# --- Spatial Feature Extraction Functions ---
# Compute distance from each grid cell to the nearest feature
def compute_distance_to_feature(gdf, lon_grid, lat_grid):
    gdf_projected = gdf.to_crs("EPSG:3031") # Project to Antarctic Steraographic for accurate distance calculations
    feature_coords = np.array([(geom.centroid.x, geom.centroid.y) for geom in gdf_projected.geometry]) # EXtract centroi coordinates of features

    # Project grid coordinates to EPSG:3031
    transformer = Transformer.from_crs("EPSG:4326", "EPSG:3031", always_xy=True)
    grid_lons, grid_lats = np.meshgrid(lon_grid, lat_grid)
    grid_coords = np.column_stack((grid_lons.ravel(), grid_lats.ravel()))
    grid_coords_projected = np.array([transformer.transform(lon, lat) for lon, lat in grid_coords])

    # Use KDTree for efficient nearest-neighbor distance calculation
    tree = cKDTree(feature_coords)
    distances, _ = tree.query(grid_coords_projected, k=1)  # Distance in meters
    return distances.reshape(grid_lons.shape) / 1000  # Convert to kilometers

# Rasterize a shapefile into a binary mask (1 if feature exists, 0 otherwise)
def rasterize_shapefile(gdf, lon_grid, lat_grid):
    shapes = [(geom, 1) for geom in gdf.geometry]
    # Create affine transform for the target grid
    transform = Affine.translation(lon_grid[0], lat_grid[0]) * Affine.scale(lon_grid[1] - lon_grid[0], lat_grid[1] - lat_grid[0])
    raster = rasterize(shapes, out_shape=(len(lat_grid), len(lon_grid)), transform=transform)
    return raster.astype(np.float32)

# --- Compute Spatial Features ---
# Initialize distance arrays for canyons and seamounts
distance_to_canyons = np.zeros_like(bathy_np)
distance_to_seamounts = np.zeros_like(bathy_np)

# Dictionary to store binary masks for other features
binary_features = {}
for feature_name, shp_path in GEOMORPH_SHAPES.items():
    gdf = gpd.read_file(shp_path).to_crs("EPSG:4326")
    if feature_name in ["canyons", "seamounts"]: # Compute distance for these features
        if feature_name == "canyons":
            distance_to_canyons = compute_distance_to_feature(gdf, lon_target, lat_target)
        elif feature_name == "seamounts":
            distance_to_seamounts = compute_distance_to_feature(gdf, lon_target, lat_target)
    else:  # Create binary mask for other features
        binary_features[feature_name] = rasterize_shapefile(gdf, lon_target, lat_target)

# --- Stack Features for Clustering ---
# Combine all features into a single array for clustering
