# --- Helper Functions ---
# Extract date (YYYY-MM) from filename
# Args: filepath: Path to the input file
# Returns: Date string in YYYY-MM format
# Raises: ValueError: If date cannot be extracted from filename
def extract_date_from_filename(filepath: str) -> str:
    basename = os.path.basename(filepath)
    # Exemple : "mean_ice_conc_month_2023_02.nc" -> "2023-02"
    match = re.search(r'(\d{4})[_-](\d{1,2})', basename)
    if match:
        year, month = match.groups()
        return f"{year}-{month.zfill(2)}"
    # Exemple : "mean_ice_conc_202302.nc" -> "2023-02"
    match = re.search(r'(\d{4})(\d{2})', basename)
    if match:
        year, month = match.groups()
        return f"{year}-{month}"
    raise ValueError(f"Impossible d'extraire la date depuis : {basename}")

# Regrid a DataArray tot the target grid using nearest-neighbor interpolation
# Args: da: Input xarray DataArray; lon_target: Target longitude coordinates; lat_target: Target latitude coordinates
# Returns: Regridded DataArray with target grid
def regrid_to_target(da, lon_target, lat_target):
    coord_names = {  # Map of possible coordinate names
        'latitude': ['latitude', 'lat', 'y', 'yc'],
        'longitude': ['longitude', 'lon', 'x', 'xc']
    }
    # Find actal coordinate names in the DataArray
    lat_name = next((name for name in coord_names['latitude'] if name in da.coords), None)
    lon_name = next((name for name in coord_names['longitude'] if name in da.coords), None)

    if not lat_name or not lon_name:
        raise ValueError(f"Coordonnées lat/lon introuvables dans {da.name}. Disponibles : {list(da.coords.keys())}")

    # Extract coordinate and data values
    lats = da[lat_name].values
    lons = da[lon_name].values
    vals = da.values

    # Flatten for griddata
    if lats.ndim == 1 and lons.ndim == 1:
        lon_grid_2d, lat_grid_2d = np.meshgrid(lons, lats)  # Create 2D grid if coordinates are 1D
        lons_flat = lon_grid_2d.flatten()
        lats_flat = lat_grid_2d.flatten()
    else:
        lons_flat = lons.flatten()
        lats_flat = lats.flatten()

    vals_flat = vals.flatten()

    # Filter out NaN values
    valid_mask = ~(np.isnan(lats_flat) | np.isnan(lons_flat) | np.isnan(vals_flat))
    lons_flat = lons_flat[valid_mask]
    lats_flat = lats_flat[valid_mask]
    vals_flat = vals_flat[valid_mask]

    if len(lats_flat) == 0:
        raise ValueError(f"Aucune donnée valide après filtrage des NaN pour {da.name}")

    # Regrid using nearest-neighbor interpolation
    lon_grid, lat_grid = np.meshgrid(lon_target, lat_target)
    regridded = griddata(
        (lons_flat, lats_flat),
        vals_flat,
        (lon_grid, lat_grid),
        method='nearest',
        fill_value=np.nan
    )

    return xr.DataArray(
        regridded,
        dims=("latitude", "longitude"),
        coords={"latitude": lat_target, "longitude": lon_target},
        name=da.name
    )

#---- Load and Process Ice Concentration Data ---

#siconc_all = xr.open_dataset("C:/STAGE_Mercator.X.MHNH/EAMPA_Ice_2003-2020_Obs.nc")  # If just one file
files = sorted(glob.glob(os.path.join(INPUT_DIR, "*.nc")))  # If multiple files
ice_datasets = []

for file in files:
    try:
        # Open dataset with chunking for memory efficiency
        ds = xr.open_dataset(file, chunks={"time":10, "y": 50, "x": 50})
        # Determine the variable name (either 'ice_conc' or the first variable)
        var_name = "ice_conc" if "ice_conc" in ds.data_vars else list(ds.data_vars)[0]
        da = ds[var_name]

        # Handle multi-temporal files by averaging over time
        if 'time' in da.dims and da.sizes['time'] > 1:
            da = da.mean(dim='time', keep_attrs=True).squeeze(drop=True)

        # EXtract date from filename
        date_str = extract_date_from_filename(file)
        if '-' not in date_str:
            date_str = f"{date_str[:4]}-{date_str[4:]}"

        # Regrid to target grid
        regridded_da = regrid_to_target(da, lon_target, lat_target)
        ice_da = regridded_da.expand_dims(time=[np.datetime64(date_str)])  # Add time dimension

        ice_datasets.append(ice_da)
        print(f"✅ {os.path.basename(file)} traité. Forme : {ice_da.shape}")

    except Exception as e:
        print(f"❌ Erreur avec {os.path.basename(file)} : {str(e)[:200]}...")
        continue

# Concatenate all datasets along time dimension
siconc_all = xr.concat(ice_datasets, dim="time", combine_attrs="drop_conflicts", coords="minimal")
siconc_all = siconc_all.sel(time=slice("2003-01-01", "2025-12-31"))
siconc_all = siconc_all.to_dataset(name='ice_conc')  # Resample to monthly frequency
siconc_all = siconc_all.resample(time='1MS').mean()  # Extract the ice concentration DatArray


#---------------------------------------------------------------------------------------------------
# -- Isoline Generation Function ---
# Generate isolines from a 2D data array and shave as shapefile
# Args: data: xarray DataArray with 2D data; output_shapefile: Output shapefile path; level: Contour level (default: 0.15 = 15% ice concentration)
def generate_isolines(data, output_shapefile, level=0.15):
    plt.figure()  #Generate contour at specified level
    contour = plt.contour(data.x, data.y, data, levels=[level])
    plt.close()

    # Convert contour segments to LineString
    isolines = []
    for seg_group in contour.allsegs:
        for seg in seg_group:
            isolines.append(LineString(seg))

    gdf_isolines = gpd.GeoDataFrame(geometry=isolines, crs="EPSG:4326")
    gdf_isolines.to_file(output_shapefile)

# --- Generate Monthly Isolines (Mean and Median)
# Group by month
siconc_monthly = siconc_all.groupby("time.month")

for month, siconc_month in siconc_monthly:
    # Calculate mean and median concentration for each grid
    mean_concentration = siconc_month.mean(dim="time")  
    median_concentration = siconc_month.median(dim="time")  

    # Generate isolines for mean and median
    generate_isolines(mean_concentration, f"mean_ice_concentration_isolines_month_{month:02d}_Obs.shp")
    generate_isolines(median_concentration, f"median_ice_concentration_isolines_month_{month:02d}_Obs.shp")
print("Processing complete for Isolines. GeoTIFF files saved for each month.")

