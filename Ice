# ---- Calculate Ice Extent --

siconc_da = siconc_all["ice_conc"]
earth_radius_km = 6371.0

# Calculate celle areas accounting for latitude
lat_rad = np.deg2rad(siconc_da.latitude)
dlon = np.abs(siconc_da.longitude[1] - siconc_da.longitude[0])  # Longitude step in degrees
lat_step = np.abs(siconc_da.latitude[1] - siconc_da.latitude[0])  # Latitude step in degrees

# Calculate are of each celle in km² (1D array for latitude)
cell_area_km2_1d = (
    (earth_radius_km ** 2) *
    np.deg2rad(dlon) *
    (np.sin(np.deg2rad(siconc_da.latitude + lat_step/2)) - np.sin(np.deg2rad(siconc_da.latitude - lat_step/2)))
)
cell_area_km2 = np.tile(cell_area_km2_1d, (len(siconc_da.longitude), 1)).T  # Expand to 2D array (latitude, longitude)

# Calculate ice extent time series
ice_threshold = 0.15  # 15% ice concentration threshold for extent calculation
ice_extent_km2 = []

for time_step in siconc_da.time:
    ice_conc = siconc_da.sel(time=time_step)
    extent_mask = ice_conc >= ice_threshold
    extent_km2 = np.nansum(extent_mask.values * cell_area_km2) / 1e6  # Convert to million km²
    ice_extent_km2.append(extent_km2)

# Create time series DataArray
ice_extent_ts = xr.DataArray(
    ice_extent_km2,
    dims=["time"],
    coords={"time": siconc_da.time},
    name="ice_extent",
    attrs={"units": "million km²", "long_name": "Sea Ice Extent"},
)

# --- Plot Ice Extent Time Series ---
plt.figure(figsize=(14,7))
