from sklearn.preprocessing import StandardScaler
from sklearn.metrics import silhouette_score
from sklearn.impute import SimpleImputer
from affine import Affine
from scipy import cKDTree
from rasterio.features import rasterize
from scipy.cluster.hierarchy import linkage, fcluster, dendrogram

# -----------------DATA PREPARATION----------------------------------------

BATHY_PATH = r"bathy_EA.nc"
GEOMORPH_SHAPES = {
    "canyons": r"Canyons.shp",
    "seamounts": r"Seamounts.shp",
    "shelf_valleys": r"Shelf_valleys.shp",
    "ridges": r"Ridges.shp",
    "shelves": r"Shelf.shp",
    "fans": r"Fans.shp",
    "plateau": r"Plateaus.shp",
    "spreading_ridges": r"Spreading_ridges.shp"
}
TARGET_RES = 0.1  # Target grid resolution (0.1°)

# ---- Load and Prepare Bathymetry ---
# Open bathymetry data and ensure correct dimension names and CRS
bathy_da = rioxarray.open_rasterio(BATHY_PATH, mask_and_scale=True)
ds = xr.open_dataset(BATHY_PATH)
# Fix dimension names (swap longitude/latitude if needed)
ds = ds.rename({"longitude": "lat_tmp", "latitude": "lon_tmp"})
ds = ds.rename({"lat_tmp": "latitude", "lon_tmp": "longitude"})
bathy_da = ds["bathy"]
bathy_da = bathy_da.rio.write_crs("EPSG:4326")
bathy_da = bathy_da.squeeze()
# Transform bathymetry: Use sqrt(abs(depth)) to reduce skew from deep values
bathy_np = np.sqrt(np.abs(bathy_da.values))

# Extract grid coordinates for spatial operations
lon_target = bathy_da["longitude"].values
lat_target = bathy_da["latitude"].values

# ---- Spatial Feature Extraction ---
# Compute distance from each grid cell to the nearest feature
def compute_distance_to_feature(gdf, lon_grid, lat_grid):
    gdf_projected = gdf.to_crs("EPSG:3031")  # Project to ANtarctic Polar Stereographic for accurate distance calculations
    feature_coords = np.array([(geom.centroid.x, geom.centroid.y) for geom in gdf_projected.geometry])  #EXtract centroid coordinates of features

    # Project grid coordinates to the same CRS
    transformer = Transformer.from_crs("EPSG:4326", "EPSG:3031", always_xy=True)
    grid_lons, grid_lats = np.meshgrid(lon_grid, lat_grid)
    grid_coords = np.column_stack((grid_lons.ravel(), grid_lats.ravel()))

    # Transform grid coordinates to EPSG:3031
    grid_coords_projected = np.array([transformer.transform(lon, lat) for lon, lat in grid_coords])

    # Use KDTree for efficient nearest-neighbor distance calculation
    tree = cKDTree(feature_coords)
    distances, _ = tree.query(grid_coords_projected, k=1)  # Distance in meters
    return distances.reshape(grid_lons.shape) / 1000  #Convert to km

# Rasterize a shapefile into a binary mask (1 if feature exists, 0 otherwise)
def rasterize_shapefile(gdf, lon_grid, lat_grid):
    shapes = [(geom, 1) for geom in gdf.geometry]
    # Create affin transform for the target grid
    transform = Affine.translation(lon_grid[0], lat_grid[0]) * Affine.scale(lon_grid[1] - lon_grid[0], lat_grid[1] - lat_grid[0])
    raster = rasterize(shapes, out_shape=(len(lat_grid), len(lon_grid)), transform=transform)
    return raster.astype(np.float32)

# Initialize distance arrays for canyons and seamounts
distance_to_canyons = np.zeros_like(bathy_np)
distance_to_seamounts = np.zeros_like(bathy_np)

# Dictionary to store binary masks for other features
binary_features = {}
for feature_name, shp_path in GEOMORPH_SHAPES.items():
    gdf = gpd.read_file(shp_path).to_crs("EPSG:4326")
    if feature_name in ["canyons", "seamounts"]: # Compute distance for these features
        if feature_name == "canyons":
            distance_to_canyons = compute_distance_to_feature(gdf, lon_target, lat_target)
        elif feature_name == "seamounts":
            distance_to_seamounts = compute_distance_to_feature(gdf, lon_target, lat_target)
    else:  # Create binary mask for other geomorphological features
        binary_features[feature_name] = rasterize_shapefile(gdf, lon_target, lat_target)

# --- Stack Features fro Clustering ---
# Combine all features into a single array for clustering
feature_list = [
    bathy_np,
    distance_to_canyons,
    distance_to_seamounts,
    *binary_features.values()
]
feature_names = [
    "depth_sqrt",
    "distance_to_canyons",
    "distance_to_seamounts",
    *binary_features.keys()
]
# Stack features into a 3D array (height, width, n_features)
data = np.stack(feature_list, axis=-1)

# --- Domain 7 Mask ---
DOMAIN7_SHAPEFILE = r"Domain7.gpkg"
gdf_domain = gpd.read_file(DOMAIN7_SHAPEFILE).to_crs("EPSG:4326")
domain_geom = gdf_domain.geometry.unary_union  # Merge all geometries into one
mask_domain7 = rasterize_shapefile(gdf_domain, lon_target, lat_target).astype(bool)

# ---- Mask and Flatten Data for Clustering --
# Extract data within the domain mask
y_indices, x_indices = np.where(mask_domain7)
data_masked = data[y_indices, x_indices]  # Masked data (2D)
coords_domain7 = (y_indices, x_indices)  # Coordinates of masked pixels

# ---- Preprocess Data ---
# Reshape to 2D array (n_samples, n_features) and normalize
data_2d = data_masked.reshape(-1, data.shape[-1])
imputer = SimpleImputer(strategy="mean")  # Replace NaNs with mean
data_imputed = imputer.fit_transform(data_2d)
scaler = StandardScaler()  # Standardize features (mean=0, std=1)
data_normalized = scaler.fit_transform(data_imputed)

# --- Hierarchical Clustering (Ward's Method) ---
# Use a random sample for dendrogram visualization (to reduce computation)
np.random.seed(42)
sample_idx = np.random.choice(len(data_normalized), 65000, replace=False)
data_sample = data_normalized[sample_idx]
# Perform hierarchical clustering
Z = linkage(data_sample, method='ward')  # Ward's method for minimal variance

# --- Plot Dendrogram ---
plt.figure(figsize=(12, 6))
dendrogram(
    Z,
    truncate_mode='lastp',  # Show only the last p=12 clusters
    p=12,
    show_leaf_counts=True,
    leaf_rotation=90.,
    leaf_font_size=8.,
    show_contracted=True,
)
plt.title("Hierarchical Clustering Dendrogram (Ward, 65000 samples)")
plt.xlabel("Cluster Size")
plt.ylabel("Distance (Ward)")
plt.tight_layout()
plt.savefig("dendrogram_Benthic_65000.png", dpi=300, bbox_inches='tight')
plt.close()

# --- Assign Clustering ---
optimal_K = 12  # Given the dendrogram
labels = fcluster(Z, t=optimal_K, criterion='maxclust')  # Assign cluster labels

# --- Evaluate Clustering ---
"""# Compute silhouette score (higher = better separation)
score = silhouette_score(data_sample, labels)
print(f"Silhouette Score: {score:.3f}")"""

# --- Create Cluster Map --
# Initialize cluster map with NaN (for masked-out areas)
cluster_map = np.full(bathy_np.shape, np.nan)
# Assign cluster labels to the sampled pixels
sample_coords = (y_indices[sample_idx], x_indices[sample_idx])
cluster_map[sample_coords[0], sample_coords[1]] = labels

# Convert to xarray DataArray for export
cluster_da = xr.DataArray(
    cluster_map,
    dims=("latitude", "longitude"),
    coords={"latitude": lat_target, "longitude": lon_target},
    name="bioregions",
)

cluster_da.rio.write_crs("EPSG:4326", inplace=True)
cluster_da.rio.to_raster("benthic_bioregions_HierarchicalONLY_K=12_65000pts.tif", nodata=np.nan)
print("Clustering saved")

# --- Visualization: Violin Plots ---
# Transform data back to original scale for interpretation
data_original_scale = scaler.inverse_transform(data_sample)
df_plot = pd.DataFrame(
    data_original_scale[:, :3],  # Use first 3 features: bathymetry, canyon distance, seamount distance
    columns=["SQRT on Bathymetry (m)", "Canyon Distance (km)", "Seamount Distance (km)"]
)
df_plot["Cluster"] = labels  # Add cluster labels

# Violin plots for each feature by cluster
fig, axes = plt.subplots(1, 3, figsize=(15, 6), sharey=True)
for i, (var, title) in enumerate(zip(["SQRT on Bathymetry (m)", "Canyon Distance (km)", "Seamount Distance (km)"], ["A", "B", "C"])):
    ax = axes[i]
    sns.violinplot(
        data=df_plot,
        y="Cluster",
        x=var,
        inner="quartile",
        ax=ax,
        cut=0,
        width=0.8,
        orient='h',
        order=sorted(df_plot["Cluster"].unique()),
        palette="Set2"
    )
    ax.set_title(title)
    ax.set_xlabel(var)
    ax.set_ylabel("Cluster number" if i == 0 else "")
    if var == "SQRT on Bathymetry (m)": ax.set_xlim(0, 80)
    elif var == "Seamount Distance (km)": ax.set_xlim(0, 1200)
    elif var == "Canyon Distance (km)": ax.set_xlim(0, 1200)
plt.suptitle("Attributes of benthic regions identified by cluster analysis for East Antarctica Planning Domain")
plt.tight_layout()
plt.savefig("violin_plots_KMeans.png", dpi=300, bbox_inches='tight')
plt.close()

# ---- Cluster Statistics ---
# Compute means, std, min, max for each feature by cluster
cluster_stats = df_plot.groupby('Cluster').agg(['mean', 'std', 'min', 'max']).round(2)
